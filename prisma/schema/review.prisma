model Review{
    id String @id @default(uuid())
    customerId String
    gearItemId String
    rating Int
    comment String?

    customer User @relation(fields: [customerId], references: [id])
    gearItem GearItem @relation(fields: [gearItemId], references: [id])

     createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}