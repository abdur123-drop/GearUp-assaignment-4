model User{
    id String @id @default(uuid())
    name String
    email String @unique
    password String
    role Role @default(CUSTOMER)
    status UserStatus @default(ACTIVE)
    phone String?
    address String?

    gearItem GearItem[]
    payment Payment[]
    rentelOrder RentalOrder[]
    review Review[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}